{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "external_directory": {
      "*": "ask",
      "/usr/share/nvim/**": "allow",
      "~/.config/nvim/**": "allow",
      "~/.local/share/nvim/**": "allow",
      "~/.local/state/nvim/**": "allow",
      "~/.cache/nvim/**": "allow",
      "/tmp/opencode/**": "allow"
    }
  }
}
